# =========================================================================
# PokéDex Manager — variables de entorno (raíz, usadas por docker-compose)
# Copia este archivo a ".env" y ajusta los valores.
# =========================================================================

# --- Postgres (docker-compose local) ---
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex_dev_password
POSTGRES_DB=pokedex_manager
POSTGRES_PORT=5432

# --- Backend ---
# Cadena de conexión que usará SQLAlchemy dentro de la red de docker-compose
DATABASE_URL=postgresql+psycopg://pokedex:pokedex_dev_password@postgres:5432/pokedex_manager

# JWT propio de sesión (genera uno con: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_dev_only_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google OAuth2 / Sign-In — crea credenciales OAuth "Web application" en
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=REEMPLAZA_CON_TU_CLIENT_ID.apps.googleusercontent.com

# PokéAPI (pública, no requiere key)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_CACHE_TTL_SECONDS=3600

# Almacenamiento de imágenes:
#   - "local"  -> guarda en backend/uploads (para desarrollo, sin GCP)
#   - "gcs"    -> sube a un bucket de Google Cloud Storage
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=REEMPLAZA_CON_TU_CLIENT_ID.apps.googleusercontent.com
